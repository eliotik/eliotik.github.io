---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { SITE } from "@config";
import type { ThreadDetail } from "@utils/getThreadDetail";

export interface Props {
  detail: ThreadDetail;
}

const { detail } = Astro.props;

const canonicalURL = new URL(`/threads/${detail.slug}/`, Astro.site).href;
const firstArticle = detail.articles[0];
---

<Layout title={`${detail.title} | ${SITE.title}`} canonicalURL={canonicalURL}>
  <Header activeNav="threads" />
  <Breadcrumbs />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-4">
    <h1 class="text-2xl font-bold text-skin-base sm:text-3xl">
      {detail.title}
    </h1>

    <dl class="mt-6 mb-5 grid grid-cols-1 gap-y-3 border-y border-skin-line/40 py-3 sm:grid-cols-2 sm:gap-y-0 sm:py-3">
      <div class="flex items-baseline gap-3 sm:flex-col sm:items-start sm:gap-1 sm:px-0 sm:[&:not(:first-child)]:border-l sm:[&:not(:first-child)]:border-skin-line/40 sm:[&:not(:first-child)]:pl-4">
        <dt class="font-mono text-[10px] uppercase tracking-wider text-skin-base/50 sm:w-auto">
          Articles
        </dt>
        <dd class="font-mono text-sm font-semibold tabular-nums text-skin-base">
          {detail.articleCount}
        </dd>
      </div>
      <div class="flex items-baseline gap-3 sm:flex-col sm:items-start sm:gap-1 sm:px-0 sm:[&:not(:first-child)]:border-l sm:[&:not(:first-child)]:border-skin-line/40 sm:[&:not(:first-child)]:pl-4">
        <dt class="font-mono text-[10px] uppercase tracking-wider text-skin-base/50 sm:w-auto">
          Read time
        </dt>
        <dd class="font-mono text-sm font-semibold tabular-nums text-skin-base">
          {detail.totalReadTime} min
        </dd>
      </div>
    </dl>

    {detail.topTags.length > 0 && (
      <div class="mb-6 flex flex-wrap gap-x-4 gap-y-2">
        {detail.topTags.map(t => (
          <a
            href={`/tags/${t.tag}/`}
            class="group inline-flex items-baseline whitespace-nowrap font-mono text-sm font-semibold text-skin-base/70 transition-colors hover:text-skin-accent"
          >
            <span class="mr-0.5 text-skin-base/40 transition-colors group-hover:text-skin-accent">
              #
            </span>
            {t.tagName}
          </a>
        ))}
      </div>
    )}

    <ul class="flex flex-col divide-y divide-skin-line/40 border-y border-skin-line/60">
      {detail.articles.map(a => {
        const num = String(a.position).padStart(2, "0");
        return (
          <li>
            <a
              href={`/posts/${a.slug}/`}
              class="group grid grid-cols-[40px_1fr_auto] items-start gap-3 py-3.5 pr-1 transition-colors hover:bg-skin-card/40 sm:grid-cols-[56px_1fr_auto] sm:gap-4"
            >
              <div class="flex items-start justify-end self-stretch border-r border-skin-line/40 pr-2.5 pt-0.5 transition-colors group-hover:border-skin-accent/70 sm:pr-3">
                <span class="text-xs font-medium tabular-nums tracking-wider text-skin-base/50 transition-colors group-hover:text-skin-accent">
                  {num}
                </span>
              </div>
              <div class="min-w-0">
                <h3 class="mb-1 text-sm font-bold text-skin-accent">
                  {a.title}
                </h3>
                <p class="text-xs leading-relaxed text-skin-base/70">
                  {a.description}
                </p>
              </div>
              <span
                aria-hidden
                class="pr-1 pt-0.5 text-skin-base/40 transition-transform group-hover:translate-x-0.5 group-hover:text-skin-accent"
              >
                →
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <nav class="mt-9 flex flex-col gap-3 border-t border-skin-line/40 pt-4 sm:flex-row sm:items-center sm:justify-between">
      <a
        href="/threads/"
        class="inline-flex items-center gap-2 font-mono text-sm font-bold text-skin-base/80 transition-colors hover:text-skin-accent"
      >
        <span class="text-base leading-none">←</span>
        <span>All threads</span>
      </a>
      {firstArticle && (
        <a
          href={`/posts/${firstArticle.slug}/`}
          class="inline-flex items-center justify-center gap-2 rounded-sm border border-skin-accent bg-skin-accent px-4 py-2.5 font-mono text-sm font-bold text-skin-fill transition-opacity hover:opacity-90"
        >
          <span>Start reading</span>
          <span class="text-base leading-none">→</span>
        </a>
      )}
    </nav>
  </main>
  <Footer />
</Layout>
