---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Tag from '@components/Tag.astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { slugifyStr } from '@utils/slugify';
import ShareLinks from '@components/ShareLinks.astro';
import { SITE } from '@config';
import LinkButton from '@components/LinkButton.astro';

export interface Props {
    post: CollectionEntry<'blog'>;
    relatedPosts?: CollectionEntry<'blog'>[];
}

const { post, relatedPosts } = Astro.props;

const {
    title,
    author,
    description,
    ogImage,
    canonicalURL,
    pubDatetime,
    modDatetime,
    tags,
} = post.data;

const { Content } = await render(post);

const ogImageUrl = typeof ogImage === 'string' ? ogImage : ogImage?.src;
const ogUrl = new URL(ogImageUrl ?? `/posts/${post.id}.png`, Astro.url.origin)
    .href;

const layoutProps = {
    title: `${title} | ${SITE.title}`,
    author,
    description,
    pubDatetime,
    modDatetime,
    canonicalURL,
    ogImage: ogUrl,
    scrollSmooth: true,
};
---

<Layout {...layoutProps}>
    <Header />

    <!-- <div class="progress-container fixed top-0 z-10 h-1 w-full bg-skin-fill">
    <div class="progress-bar h-1 w-0 bg-skin-accent" id="myBar"></div>
  </div> -->

    <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
        <button
            id="go-back"
            class="focus-outline mt-8 mb-2 flex hover:opacity-75"
        >
            <svg xmlns="http://www.w3.org/2000/svg"
                ><path
                    d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
                ></path>
            </svg><span>Go back</span>
        </button>
    </div>
    <main id="main-content">
        <h1 transition:name={slugifyStr(title)} class="post-title">{title}</h1>
        <article id="article" class="prose mx-auto mt-8 max-w-3xl">
            <Content />
            {
                relatedPosts?.length ? (
                    <aside class="related-posts">
                        <>
                            <h2>
                                You might like to read one of these posts next:
                            </h2>
                            {relatedPosts.map(relatedPost => {
                                const isCurrent = relatedPost.id === post.id;
                                return (
                                    <p>
                                        <LinkButton
                                            href={`/posts/${relatedPost.id}/`}
                                            title={relatedPost.data.title}
                                            ariaLabel={relatedPost.id}
                                            disabled={isCurrent}
                                            className={
                                                isCurrent
                                                    ? 'text-skin-base/60 cursor-default italic'
                                                    : ''
                                            }
                                        >
                                            {relatedPost.data.description}
                                            {isCurrent && (
                                                <span class="text-skin-accent ml-2 font-mono text-xs whitespace-nowrap not-italic">
                                                    (you are here)
                                                </span>
                                            )}
                                        </LinkButton>
                                    </p>
                                );
                            })}
                        </>
                    </aside>
                ) : null
            }
        </article>

        <ul class="my-8">
            {tags.map(tag => <Tag tag={slugifyStr(tag)} />)}
        </ul>

        <div
            class="flex flex-col-reverse items-center justify-between gap-6 sm:flex-row-reverse sm:items-end sm:gap-4"
        >
            <button
                id="back-to-top"
                class="focus-outline py-1 whitespace-nowrap hover:opacity-75"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="rotate-90">
                    <path
                        d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
                    ></path>
                </svg>
                <span>Back to Top</span>
            </button>

            <ShareLinks />
        </div>
    </main>
    <Footer />
</Layout>

<style>
    @reference "../styles/base.css";
    main {
        @apply mx-auto w-full max-w-3xl px-4 pb-12;
    }
    .post-title {
        @apply text-skin-accent text-2xl font-semibold;
    }
</style>

<script is:inline>
    (function () {
        /** Create a progress indicator
         *  at the top */
        function createProgressBar() {
            // Don't create if body doesn't exist yet
            if (!document.body) return;

            // Only create progress bar on post detail pages
            if (!document.getElementById('article')) return;

            // Remove existing progress bar if it exists (for View Transitions)
            const existing = document.getElementById('myBar');
            if (existing) {
                existing.parentElement?.remove();
            }

            // Create the main container div
            const progressContainer = document.createElement('div');
            progressContainer.className =
                'progress-container fixed top-0 z-10 h-1 w-full bg-skin-fill';

            // Create the progress bar div
            const progressBar = document.createElement('div');
            progressBar.className = 'progress-bar h-1 w-0 bg-skin-accent';
            progressBar.id = 'myBar';

            // Append the progress bar to the progress container
            progressContainer.appendChild(progressBar);

            // Append the progress container to the document body or any other desired parent element
            document.body.appendChild(progressContainer);
        }

        /** Update the progress bar
         *  when user scrolls */
        function updateScrollProgress() {
            const winScroll =
                document.body?.scrollTop || document.documentElement.scrollTop;
            const height =
                document.documentElement.scrollHeight -
                document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            if (document) {
                const myBar = document.getElementById('myBar');
                if (myBar) {
                    myBar.style.width = scrolled + '%';
                }
            }
        }

        function attachScrollListener() {
            document.addEventListener('scroll', updateScrollProgress);
        }

        function detachScrollListener() {
            document.removeEventListener('scroll', updateScrollProgress);
        }

        /** Attaches links to headings in the document,
         *  allowing sharing of sections easily */
        function addHeadingLinks() {
            // Only add heading links if we're on a post detail page
            const article = document.getElementById('article');
            if (!article) return;

            // Only select headings within the article content
            const headings = Array.from(
                article.querySelectorAll('h2, h3, h4, h5, h6')
            );
            for (const heading of headings) {
                // Skip if heading already has a link (prevents duplicates)
                if (heading.querySelector('.heading-link')) continue;

                // Headings authored in this layout (e.g. the related-posts
                // heading) have no id, so '#' + heading.id would produce a
                // bare href="#" — a permalink to nowhere that still pushes a
                // history entry and swallows a "Go back" press.
                if (!heading.id) continue;

                heading.classList.add('group');
                const link = document.createElement('a');
                link.innerText = '#';
                link.className =
                    'heading-link hidden group-hover:inline-block ml-2';
                link.href = '#' + heading.id;
                link.ariaHidden = 'true';
                heading.appendChild(link);
            }
        }

        /** In-article anchor clicks (the remark-toc table of contents and the
         *  heading permalinks above) are same-document navigations, but the
         *  browser — and Astro's ClientRouter — still push a history entry for
         *  each one. "Go back" then pops that entry and the reader stays on the
         *  same article, which reads as a dead button: three TOC clicks means
         *  three presses before you leave the post.
         *
         *  Scroll to the target ourselves and update the URL with
         *  replaceState, so deep links still work but the back stack stays
         *  clean. Astro's ClientRouter listens for clicks on `document` in the
         *  bubble phase and bails when defaultPrevented is set, so handling
         *  this on #article (a descendant) runs first and takes precedence. */
        function anchorClickHandler(event) {
            if (event.defaultPrevented) return;
            // Let the browser handle open-in-new-tab/window and non-left
            // clicks. Same idiom as ClientRouter's own leavesWindow(): a
            // keyboard activation has no button, so test for truthiness first
            // rather than `!== 0`, which would drop Enter-on-link.
            if (
                (event.button && event.button !== 0) ||
                event.metaKey ||
                event.ctrlKey ||
                event.altKey ||
                event.shiftKey
            )
                return;

            const target = event.target;
            if (!(target instanceof Element)) return;
            const link = target.closest('a[href^="#"]');
            if (!link) return;

            const href = link.getAttribute('href');
            const id = decodeURIComponent(href.slice(1));
            if (!id) return;
            const destination = document.getElementById(id);
            if (!destination) return;

            event.preventDefault();
            destination.scrollIntoView();
            // Preserve the ClientRouter's {index, scrollX, scrollY} bookkeeping
            history.replaceState(history.state, '', href);
            // Native fragment navigation moves focus; keep that for a11y.
            destination.setAttribute('tabindex', '-1');
            destination.focus({ preventScroll: true });
        }

        function attachAnchorHandler() {
            document
                .getElementById('article')
                ?.addEventListener('click', anchorClickHandler);
        }

        /** Astro's ClientRouter stamps every history entry it manages with an
         *  incrementing history.state.index. An index of 0 means this page is
         *  the first entry in the tab — arrived at from a search result, a
         *  shared link, a bookmark or a new tab — so history.back() would
         *  either do nothing at all or dump the reader off the site entirely.
         *  Fall back to the post listing in that case. */
        function goBackHandler() {
            const index =
                history.state && typeof history.state.index === 'number'
                    ? history.state.index
                    : 0;
            if (index > 0) {
                history.back();
            } else {
                window.location.href = '/posts/';
            }
        }

        function attachGoBack() {
            document
                .querySelector('#go-back')
                ?.addEventListener('click', goBackHandler);
        }

        function detachGoBack() {
            document
                .querySelector('#go-back')
                ?.removeEventListener('click', goBackHandler);
        }

        /** Scrolls the document to the top when
         * the "Back to Top" button is clicked. */
        function backToTopHandler() {
            document.body.scrollTop = 0; // For Safari
            document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
        }

        function attachBackToTop() {
            document
                .querySelector('#back-to-top')
                ?.addEventListener('click', backToTopHandler);
        }

        function detachBackToTop() {
            document
                .querySelector('#back-to-top')
                ?.removeEventListener('click', backToTopHandler);
        }

        /** Initialize all post detail features */
        function initPostDetails() {
            createProgressBar();
            attachScrollListener();
            addHeadingLinks();
            attachAnchorHandler();
            attachBackToTop();
            attachGoBack();

            // Clean up listeners before the next View Transition swap so they
            // don't stack up across navigations. { once: true } ensures this
            // cleanup handler itself is removed after firing once.
            document.addEventListener(
                'astro:before-swap',
                function cleanup() {
                    detachScrollListener();
                    detachBackToTop();
                    detachGoBack();
                },
                { once: true }
            );
        }

        // Run on initial load
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPostDetails);
        } else {
            // DOM already loaded
            initPostDetails();
        }

        // Re-run on View Transitions navigation (after DOM swap completes)
        document.addEventListener('astro:after-swap', initPostDetails);
    })();
</script>
