---
import { type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import Pagination from "@components/Pagination.astro";
import { SITE } from "@config";
import type { ThreadPositions } from "@utils/getThreadPositions";
import type { RelatedTag } from "@utils/getRelatedTags";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedEntities: CollectionEntry<"blog">[];
  tag: string;
  tagName: string;
  threadPositions?: ThreadPositions;
  totalCount?: number;
  relatedTags?: RelatedTag[];
}

const {
  currentPage,
  totalPages,
  paginatedEntities,
  tag,
  tagName,
  threadPositions,
  totalCount,
  relatedTags = [],
} = Astro.props;

const canonicalURL = new URL(
  `/tags/${tag}${currentPage > 1 ? `/${currentPage}` : ""}`,
  Astro.site
).href;
---

<Layout
  title={`Tag: ${tagName} | ${SITE.title}`}
  canonicalURL={canonicalURL}
  noindex={currentPage > 1}
>
  <Header activeNav="tags" />
  <Main
    pageTitle={["#", `${tagName}`]}
    titleTransition={tag}
    pageDesc={`All articles tagged with #${tagName}.`}
  >
    {totalCount !== undefined && (
      <span
        slot="header-meta"
        class="font-mono text-sm tabular-nums text-skin-base/70"
      >
        <strong class="font-semibold text-skin-base">{totalCount}</strong>
        {" "}articles
      </span>
    )}

    {relatedTags.length > 0 && (
      <section class="my-6 border-y border-dashed border-skin-line/60 py-4">
        <h2 class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-skin-base/60">
          Related tags
        </h2>
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          {relatedTags.map(({ tag: relTag, tagName: relName }) => (
            <a
              href={`/tags/${relTag}/`}
              class="group inline-flex items-baseline whitespace-nowrap font-mono text-sm font-semibold text-skin-accent transition-colors hover:underline"
            >
              <span class="mr-0.5 text-skin-base/40 transition-colors group-hover:text-skin-accent">#</span>{relName}
            </a>
          ))}
        </div>
      </section>
    )}

    <ul class="divide-y divide-dashed divide-skin-line/60">
      {
        paginatedEntities.map(({ data, slug }) => (
          <Card
            href={`/posts/${slug}/`}
            frontmatter={data}
            threadPosition={threadPositions?.[slug]}
          />
        ))
      }
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/tags/${tag}${
      currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
    }`}
    nextUrl={`/tags/${tag}/${currentPage + 1}`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
