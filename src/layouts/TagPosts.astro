---
import { type CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Main from '@layouts/Main.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Card from '@components/Card';
import Pagination from '@components/Pagination.astro';
import { SITE } from '@config';
import type { ThreadPositions } from '@utils/getThreadPositions';
import type { RelatedTag } from '@utils/getRelatedTags';

export interface Props {
    currentPage: number;
    totalPages: number;
    paginatedEntities: CollectionEntry<'blog'>[];
    tag: string;
    tagName: string;
    threadPositions?: ThreadPositions;
    totalCount?: number;
    relatedTags?: RelatedTag[];
}

const {
    currentPage,
    totalPages,
    paginatedEntities,
    tag,
    tagName,
    threadPositions,
    totalCount,
    relatedTags = [],
} = Astro.props;

const canonicalURL = new URL(
    `/tags/${tag}${currentPage > 1 ? `/${currentPage}` : ''}`,
    Astro.site
).href;
---

<Layout
    title={`Tag: ${tagName} | ${SITE.title}`}
    canonicalURL={canonicalURL}
    noindex={currentPage > 1}
>
    <Header activeNav="tags" />
    <Main
        pageTitle={['#', `${tagName}`]}
        titleTransition={tag}
        pageDesc={`All articles tagged with #${tagName}.`}
    >
        {
            totalCount !== undefined && (
                <span
                    slot="header-meta"
                    class="text-skin-base/70 font-mono text-sm tabular-nums"
                >
                    <strong class="text-skin-base font-semibold">
                        {totalCount}
                    </strong>{' '}
                    articles
                </span>
            )
        }

        {
            relatedTags.length > 0 && (
                <section class="border-skin-line/60 my-6 border-y border-dashed py-4">
                    <h2 class="text-skin-base/60 mb-3 font-mono text-xs font-semibold tracking-wider uppercase">
                        Related tags
                    </h2>
                    <div class="flex flex-wrap gap-x-4 gap-y-2">
                        {relatedTags.map(
                            ({ tag: relTag, tagName: relName }) => (
                                <a
                                    href={`/tags/${relTag}/`}
                                    class="group text-skin-accent inline-flex items-baseline font-mono text-sm font-semibold whitespace-nowrap transition-colors hover:underline"
                                >
                                    <span class="text-skin-base/40 group-hover:text-skin-accent mr-0.5 transition-colors">
                                        #
                                    </span>
                                    {relName}
                                </a>
                            )
                        )}
                    </div>
                </section>
            )
        }

        <ul class="divide-skin-line/60 divide-y divide-dashed">
            {
                paginatedEntities.map(({ data, id }) => (
                    <Card
                        href={`/posts/${id}/`}
                        frontmatter={data}
                        threadPosition={threadPositions?.[id]}
                    />
                ))
            }
        </ul>
    </Main>

    <Pagination
        {currentPage}
        {totalPages}
        prevUrl={`/tags/${tag}${
            currentPage - 1 !== 1 ? '/' + (currentPage - 1) : ''
        }`}
        nextUrl={`/tags/${tag}/${currentPage + 1}`}
    />

    <Footer noMarginTop={totalPages > 1} />
</Layout>
