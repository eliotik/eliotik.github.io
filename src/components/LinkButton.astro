---
export interface Props {
    href: string;
    className?: string;
    ariaLabel?: string;
    title?: string;
    disabled?: boolean;
    class?: string;
}

const {
    href,
    className,
    ariaLabel,
    title,
    disabled = false,
    class: scopedClass,
} = Astro.props;

// Only forward the parent's scoped-style class when the caller explicitly
// passed a className, matching Astro 6's behaviour of splicing the scope
// hash into an existing className value. Callers that pass no className
// (e.g. the plain "All Posts" LinkButton) must not gain one either.
const forwardedScope = className !== undefined ? scopedClass : undefined;
---

{
    disabled ? (
        <span
            class:list={['group', 'inline-block', className, forwardedScope]}
            aria-label={ariaLabel}
            title={title}
            aria-disabled={disabled}
        >
            <slot />
        </span>
    ) : (
        <a
            {href}
            class:list={[
                'group',
                'hover:text-skin-accent',
                'inline-block',
                className,
                forwardedScope,
            ]}
            aria-label={ariaLabel}
            title={title}
        >
            <slot />
        </a>
    )
}
