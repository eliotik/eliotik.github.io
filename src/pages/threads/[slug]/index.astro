---
import { getCollection } from "astro:content";
import ThreadDetail from "@layouts/ThreadDetail.astro";
import getThreadDetail from "@utils/getThreadDetail";
import { slugifyStr } from "@utils/slugify";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  const threadNames = new Set<string>();
  posts.forEach(p => {
    if (p.data.thread) threadNames.add(p.data.thread);
  });

  return Array.from(threadNames).map(thread => ({
    params: { slug: slugifyStr(thread) },
    props: { thread, posts },
  }));
}

const { thread, posts } = Astro.props;
const detail = getThreadDetail(posts, thread);
---

{detail && <ThreadDetail detail={detail} />}
