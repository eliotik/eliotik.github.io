{
    "name": "eliotik.github.io",
    "version": "0.0.1",
    "type": "module",
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro check && astro build && jampack ./dist",
        "preview": "astro preview",
        "astro": "astro",
        "sync": "astro sync",
        "format:check": "prettier --plugin-search-dir=. --check .",
        "format": "prettier --plugin-search-dir=. --write .",
        "prepare": "husky",
        "lint": "eslint .",
        "clean": "./clean-cache.sh",
        "fresh": "./clean-cache.sh && pnpm dev"
    },
    "engines": {
        "node": "22.22.2"
    },
    "dependencies": {
        "@astrojs/check": "0.9.9",
        "@astrojs/mdx": "5.0.4",
        "@astrojs/partytown": "^2.1.7",
        "@astrojs/react": "5.0.4",
        "@astrojs/rss": "4.0.19",
        "@astrojs/sitemap": "3.7.3",
        "@astrojs/ts-plugin": "1.10.10",
        "@expressive-code/plugin-collapsible-sections": "0.44.0",
        "@expressive-code/plugin-line-numbers": "0.44.0",
        "@resvg/resvg-js": "2.6.2",
        "astro": "6.2.1",
        "astro-expressive-code": "0.44.0",
        "fuse.js": "7.4.2",
        "github-slugger": "2.0.0",
        "remark-collapse": "0.1.2",
        "remark-toc": "9.0.0",
        "satori": "0.26.0",
        "sharp": "^0.35.3",
        "tailwindcss": "4.3.2"
    },
    "devDependencies": {
        "@divriots/jampack": "0.34.1",
        "@eslint/js": "^9.39.4",
        "@tailwindcss/typography": "0.5.19",
        "@tailwindcss/vite": "^4.2.4",
        "@types/github-slugger": "2.0.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "8.59.1",
        "@typescript-eslint/parser": "8.59.1",
        "astro-eslint-parser": "1.4.0",
        "eslint": "9.39.4",
        "eslint-plugin-astro": "1.7.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "husky": "9.1.7",
        "lint-staged": "16.4.0",
        "prettier": "3.8.3",
        "prettier-plugin-astro": "0.14.1",
        "prettier-plugin-tailwindcss": "0.8.0",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "typescript": "6.0.3"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,md,mdx,json}": [
            "prettier --plugin-search-dir=. --write"
        ],
        "*.{js,jsx,ts,tsx,astro}": [
            "eslint --fix"
        ]
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@swc/core",
            "contentlayer",
            "esbuild",
            "protobufjs",
            "sharp"
        ]
    }
}
