  /* ===== scrollbar ===== */
  html {
    overflow-y: scroll;
  }

  /* width */
  ::-webkit-scrollbar {
  width: 0.75rem;
}

  /* Track */
  ::-webkit-scrollbar-track {
  --tw-bg-opacity: 1;
  background-color: rgba(var(--color-fill), var(--tw-bg-opacity));
}

  /* Handle */
  ::-webkit-scrollbar-thumb {
  --tw-bg-opacity: 1;
  background-color: rgba(var(--color-card), var(--tw-bg-opacity));
}

  /* Handle on hover */
  ::-webkit-scrollbar-thumb:hover {
  --tw-bg-opacity: 1;
  background-color: rgba(var(--color-card-muted), var(--tw-bg-opacity));
}

  code,
  blockquote {
    word-wrap: break-word;
  }

  pre > code {
    white-space: pre;
  }

