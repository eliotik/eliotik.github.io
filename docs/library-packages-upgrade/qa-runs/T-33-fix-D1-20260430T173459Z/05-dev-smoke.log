    (function () {
        /** Scrolls the document to the top when
         * the "Back to Top" button is clicked. */
        function backToTop() {
            document
                .querySelector('#back-to-top')
                ?.addEventListener('click', () => {
                    document.body.scrollTop = 0; // For Safari
                    document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
                });
        }
        backToTop();
        document.addEventListener('astro:after-swap', backToTop);

        /** Toggle tips visibility */
        function setupToggleTips() {
            const toggleButton = document.querySelector('#toggle-tips');
            const toggleText = document.querySelector('#toggle-text');
            const tipContents = document.querySelectorAll('.tip-content');
            const individualToggleBtns =
                document.querySelectorAll('.tip-toggle-btn');

            if (!toggleButton || !toggleText) return;

            // Remove any existing listeners by cloning the button
            const newToggleButton = toggleButton.cloneNode(true);
            toggleButton.parentNode.replaceChild(newToggleButton, toggleButton);

            // Get saved state from localStorage, default to collapsed (false)
            const isExpanded = localStorage.getItem('tipsExpanded') === 'true';

            // Apply initial state
            tipContents.forEach(content => {
                content.style.display = isExpanded ? 'block' : 'none';
            });

            // Update individual toggle icons based on initial state
            individualToggleBtns.forEach(btn => {
                const icon = btn.querySelector('.chevron-icon');
                if (icon) {
                    if (isExpanded) {
                        icon.classList.add('expanded');
                    } else {
                        icon.classList.remove('expanded');
                    }
                }
            });

            const newToggleText = newToggleButton.querySelector('#toggle-text');
            if (newToggleText) {
                newToggleText.textContent = isExpanded
                    ? 'Collapse All'
                    : 'Expand All';
            }

            // Toggle all handler
            newToggleButton.addEventListener('click', () => {
                const currentlyExpanded =
                    localStorage.getItem('tipsExpanded') === 'true';
                const newState = !currentlyExpanded;

                const allTipContents =
                    document.querySelectorAll('.tip-content');
                allTipContents.forEach(content => {
                    content.style.display = newState ? 'block' : 'none';
                });

                const allToggleBtns =
                    document.querySelectorAll('.tip-toggle-btn');
                allToggleBtns.forEach(btn => {
                    const icon = btn.querySelector('.chevron-icon');
                    if (icon) {
                        if (newState) {
                            icon.classList.add('expanded');
                        } else {
                            icon.classList.remove('expanded');
                        }
                    }
                });

                const textElement = document.querySelector('#tog* Connection #0 to host localhost left intact
gle-text');
                if (textElement) {
                    textElement.textContent = newState
                        ? 'Collapse All'
                        : 'Expand All';
                }
                localStorage.setItem('tipsExpanded', String(newState));
            });

            // Individual tip toggle handlers - clone buttons to remove old listeners
            const freshToggleBtns =
                document.querySelectorAll('.tip-toggle-btn');
            freshToggleBtns.forEach(btn => {
                const newBtn = btn.cloneNode(true);
                btn.parentNode.replaceChild(newBtn, btn);

                newBtn.addEventListener('click', e => {
                    e.preventDefault();
                    e.stopPropagation();
                    const slug = newBtn.getAttribute('data-tip-slug');
                    const content = document.querySelector(
                        `.tip-content[data-tip-slug="${slug}"]`
                    );
                    const icon = newBtn.querySelector('.chevron-icon');

                    if (content && icon) {
                        const isCurrentlyVisible =
                            content.style.display === 'block';
                        content.style.display = isCurrentlyVisible
                            ? 'none'
                            : 'block';

                        if (isCurrentlyVisible) {
                            icon.classList.remove('expanded');
                        } else {
                            icon.classList.add('expanded');
                        }
                    }
                });
            });
        }

        setupToggleTips();
        document.addEventListener('astro:after-swap', setupToggleTips);
        document.addEventListener('astro:page-load', setupToggleTips);
    })();
