diff --git a/src/components/Breadcrumbs.astro b/src/components/Breadcrumbs.astro
index 1034e9a..6e932d7 100644
--- a/src/components/Breadcrumbs.astro
+++ b/src/components/Breadcrumbs.astro
@@ -8,18 +8,19 @@ const breadcrumbList = currentUrlPath.split("/").slice(1);
 
 // if breadcrumb is Home > Posts > 1 <etc>
 // replace Posts with Posts (page number)
-breadcrumbList[0] === "posts" &&
+if (breadcrumbList[0] === "posts") {
   breadcrumbList.splice(0, 2, `Posts (page ${breadcrumbList[1] || 1})`);
+}
 
 // if breadcrumb is Home > Posts > 1 <etc>
 // replace Posts with Posts (page number)
-breadcrumbList[0] === "tips" &&
+if (breadcrumbList[0] === "tips") {
   breadcrumbList.splice(0, 2, `Tips (page ${breadcrumbList[1] || 1})`);
+}
 
 // if breadcrumb is Home > Tags > [tag] > [page] <etc>
 // replace [tag] > [page] with [tag] (page number)
-breadcrumbList[0] === "tags" &&
-  !isNaN(Number(breadcrumbList[2])) &&
+if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
   breadcrumbList.splice(
     1,
     3,
@@ -27,6 +28,7 @@ breadcrumbList[0] === "tags" &&
       Number(breadcrumbList[2]) === 1 ? "" : "(page " + breadcrumbList[2] + ")"
     }`
   );
+}
 ---
 
 <nav class="breadcrumb" aria-label="breadcrumb">
